# Set these only in Vercel Project Settings > Environment Variables.
# Do not commit real values to GitHub or put them in config.js.
# Use the pooled Neon connection string for serverless functions.
DATABASE_URL=postgresql://user:password@your-neon-host-pooler/database?sslmode=require
RSVP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: use pending to approve wishes before publishing them.
# RSVP_WISH_MODE=pending

# Keep unset (or true) for normal RSVP submissions. Set false only while
# performing a controlled maintenance or final data-sync window.
# RSVP_WRITE_ENABLED=false
