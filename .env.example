# Set these in Vercel Project Settings > Environment Variables.
# Do not commit the real values to GitHub or put them in config.js.
# The existing RSVP endpoint remains on Supabase until the Neon cutover is complete.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
RSVP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: use pending to approve wishes in the Supabase dashboard before publishing.
# RSVP_WISH_MODE=pending

# Keep unset (or true) for normal RSVP submissions. Set false briefly before
# the final Supabase-to-Neon snapshot so no late RSVP write is missed.
# RSVP_WRITE_ENABLED=false

# Neon migration preparation. Use the pooled Neon connection string in Vercel.
# Keep RSVP_HASH_SECRET unchanged during the later cutover so RSVP phone hashes
# continue to identify the same guests.
DATABASE_URL=postgresql://user:password@your-neon-host-pooler/database?sslmode=require
NEON_MIGRATION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
